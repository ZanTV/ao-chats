# AO Chats Backend — Development
# Copy to .env.development (or legacy .env)

NODE_ENV=development
PORT=3001

#

# Local Redis
REDIS_URL=redis://localhost:6379

# Local service URLs
CLIENT_URL=http://localhost:8081
API_URL=http://localhost:3001
SOCKET_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:8081
SOCKET_CORS_ORIGIN=http://localhost:8081

# JWT (development only — change before production)
JWT_SECRET=dev-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Email (optional in dev — verification codes log to console when unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AO Chats <noreply@aochats.com>

VERIFY_CODE_EXPIRY_MINUTES=5

# Object storage (optional — not used until uploads are enabled)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
