# AO Chats Backend — Production
# Set these in Railway dashboard (never commit real values)
# Copy to .env.production for local production smoke tests only

NODE_ENV=production
PORT=3001

# Database — Neon PostgreSQL (set in Railway; use pooled URL for Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?channel_binding=require&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@HOST/neondb?channel_binding=require&connect_timeout=15&sslmode=require

REDIS_URL=rediss://default:gQAAAAAAAo5iAAIgcDEwYWNjN2QwMDg0NGI0MGM3ODYxZGYxYTg4ZWE2MDkxYQ@polite-owl-167522.upstash.io:6379

CLIENT_URL=https://www.aochats.chat
API_URL=https://api.aochats.chat
SOCKET_URL=https://api.aochats.chat
CORS_ORIGIN=https://www.aochats.chat
SOCKET_CORS_ORIGIN=https://www.aochats.chat

JWT_SECRET=<Production Secret>
JWT_REFRESH_SECRET=<Production Refresh Secret>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

SMTP_HOST=<SMTP Host>
SMTP_PORT=587
SMTP_USER=<SMTP Username>
SMTP_PASS=<SMTP Password>
EMAIL_FROM=AO Chats <noreply@aochats.com>

VERIFY_CODE_EXPIRY_MINUTES=5

OBJECT_STORAGE_ENDPOINT=<Storage Endpoint>
OBJECT_STORAGE_BUCKET=<Bucket Name>

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
