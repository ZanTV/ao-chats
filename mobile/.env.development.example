# AO Chats Mobile — Development
# Copy to .env.development (or legacy .env)

EXPO_PUBLIC_APP_NAME=AO Chats
EXPO_PUBLIC_APP_URL=http://localhost:8081
EXPO_PUBLIC_ENV=development

# Optional — defaults to Metro LAN / localhost:3001 when omitted
# EXPO_PUBLIC_API_URL=http://localhost:3001/api
# EXPO_PUBLIC_SOCKET_URL=http://localhost:3001
# EXPO_PUBLIC_STORAGE_URL=http://localhost:8081

# Uncomment to point at production API while developing UI:
# EXPO_PUBLIC_API_URL=https://api.aochats.chat/api
# EXPO_PUBLIC_SOCKET_URL=https://api.aochats.chat
# EXPO_PUBLIC_STORAGE_URL=https://www.aochats.chat
# EXPO_PUBLIC_ENV=production
